{
  "name": "dayz-scripts-docs",
  "version": "1.0.0",
  "description": "Custom documentation generator for DayZ Enforce Script sources",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch": "node src/fetch.js",
    "parse": "node src/parse-all.js",
    "generate": "node src/generate/index.js",
    "generate:latest": "BUILD_VERSIONS=1 node src/generate/index.js",
    "generate:verify": "BUILD_VERSIONS=6 GENERATE_VERIFY=1 node src/generate/index.js",
    "build": "npm run fetch && npm run parse && npm run generate",
    "test": "node --test 'test/*.test.js'",
    "dev": "node src/serve.js"
  },
  "license": "MIT"
}
